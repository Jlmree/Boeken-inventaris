# Kopieer naar .env en pas aan.

# Wachtwoord voor het hele gezin (verplicht). Kies iets lang.
FAMILY_PASSWORD=verander-mij

# Wie er in het gezin zit, komma-gescheiden. Dit zijn de keuzes bij "van wie".
MEMBERS=Papa,Mama,Kind

# Optioneel: AI-herkenning van foto's (type, kleur, seizoen, materiaal).
# Zonder sleutel blijft alles werken, alleen zonder de AI-knop.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Achter een reverse proxy met https (Caddy of nginx): zet beide op 1.
TRUST_PROXY=1
COOKIE_SECURE=1

# Hoeveel dagen je ingelogd blijft op een toestel.
SESSION_DAYS=90
